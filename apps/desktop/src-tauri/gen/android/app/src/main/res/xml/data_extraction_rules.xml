<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a transfer to a new phone: mail and secrets come back by signing in again
     or restoring a Buun Mail backup file, which is sealed with a passphrase. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
