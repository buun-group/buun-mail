{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buun Mail",
  "version": "0.4.0",
  "identifier": "com.buungroup.mail",
  "build": {
    "devUrl": "http://localhost:28600",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm --filter @buun-mail/ui dev",
    "beforeBuildCommand": "pnpm --filter @buun-mail/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Buun Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' about: data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
