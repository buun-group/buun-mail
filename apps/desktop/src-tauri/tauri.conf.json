{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buun Mail",
  "version": "0.5.0",
  "identifier": "com.buungroup.mail",
  "build": {
    "devUrl": "http://localhost:28600",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "pnpm --filter @buun-mail/ui dev",
    "beforeBuildCommand": "pnpm --filter @buun-mail/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "Buun Mail",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "label": "main",
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'self' about: data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-only",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Buun Group",
    "homepage": "https://github.com/buun-group/buun-mail",
    "copyright": "Copyright 2026 Buun Group. GPL-3.0-only.",
    "shortDescription": "One inbox for every address you run",
    "longDescription": "A local-first mail client that files every message by the exact address it was delivered to, across your own domains, IMAP mailboxes and dissolve.email.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "icons/installer/nsis-header.bmp",
        "startMenuFolder": "Buun Mail"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc3MDg3MTcxRUExNzc4NUUKUldSZWVCZnFjWEVJZCsvcndEbnV0SlpiT25zeFBtSjJCeFYvVWdWQXUvTDVuT29VNW1BZ3lnRFoK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
