{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core events, drawing its own title bar, picking files to import and where to save an export or an attachment, desktop notifications, and opening links in the browser: the Buun Group product sites, and the web and mailto links a person clicks in a message.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://plotwork.dev"
        },
        {
          "url": "https://flung.dev"
        },
        {
          "url": "https://gunspec.io"
        },
        {
          "url": "https://dissolve.email"
        },
        {
          "url": "https://cryptflare.com"
        },
        {
          "url": "https://buungroup.com"
        },
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    }
  ]
}
