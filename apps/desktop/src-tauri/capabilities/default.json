{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: core events, and opening only the Buun Group product sites in the browser.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://plotwork.dev" },
        { "url": "https://flung.dev" },
        { "url": "https://gunspec.io" },
        { "url": "https://dissolve.email" },
        { "url": "https://cryptflare.com" },
        { "url": "https://buungroup.com" }
      ]
    }
  ]
}
