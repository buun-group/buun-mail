{
  "name": "@buun-mail/brand",
  "version": "0.0.0",
  "private": true,
  "description": "The Buun Mail brand: the Arrival mark, wordmark and lockups, favicons and app icons, social and email images, and the motion system with React components.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./motion.css": "./src/css/motion.css",
    "./svg/*": "./src/svg/*",
    "./assets/*": "./assets/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "preview": "vite --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "opentype.js": "1.3.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@fontsource-variable/geist": "5.3.0"
  }
}
