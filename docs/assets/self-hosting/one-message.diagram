sequence "One message, start to finish" numbered=on desc="A sender delivers to an address on your domain. Email Routing passes it to the gateway with its envelope recipient. The gateway stores it in D1 and has the notifier tell the app over the WebSocket. The app collects: one request returns the message itself. It files it by recipient, and its next collect acknowledges it, so the gateway deletes its copy."

actor sender external "Sender"
actor routing gateway "Email Routing" icon=cloudflare:email-routing
actor gw function "Gateway" icon=cloudflare:workers
actor db database "D1" icon=cloudflare:d1
actor notifier service "Notifier" icon=cloudflare:durable-objects
actor app client "Buun Mail" icon=lucide:monitor

sender -> routing : "to hi@example.com"
routing -> gw : "catch-all"
gw -> db : "store"
gw ..> notifier : "new mail"
notifier ..> app : "WebSocket"
app -> gw : "collect"
gw --> app : "the .eml, inline"
note over app : "Filed by recipient"
app -> gw : "collect, ack"
gw -> db : "delete"
gw --> app : "nothing left"
